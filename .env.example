# Порт на хосте (внутри контейнера приложение всегда слушает 8080)
APP_PORT=8080

# --- LLM (опционально). Ключ, адрес API и модель в коде не прописаны.
# Рекомендуемый способ — ввести их в терминале при запуске:  python run.py
# (ключ вводится скрыто и нигде не сохраняется). Без них агент работает на встроенных правилах.
# Можно и задать здесь или переменными окружения: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL.
LLM_TIMEOUT=30

# --- Хранилище SQLite: в Docker — /data/agent.db (volume), без Docker — ./data/agent.db
# DB_PATH=

# --- Telegram-бот (опционально): тот же агент в мессенджере
TELEGRAM_BOT_TOKEN=

# --- Зафиксировать «сегодня» для воспроизводимого демо (YYYY-MM-DD), пусто — реальная дата
APP_TODAY=

LOG_LEVEL=INFO

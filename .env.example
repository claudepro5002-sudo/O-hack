# Все переменные проекта. Значения здесь пустые — реальные кладутся в .env (он в .gitignore),
# для жюри .env передаётся только в зашифрованном виде: secrets.env.age (см. README, «Ключи и секреты»).
# Пустое значение = значение по умолчанию (указано в комментарии).

# --- LLM: любой OpenAI-совместимый API. Без этих трёх переменных агент работает на встроенных правилах.
# Ключ API cloud.ru Foundation Models (консоль cloud.ru → Foundation Models → API-ключи).
# Для жюри создайте ОТДЕЛЬНЫЙ ключ
LLM_API_KEY=
# Адрес API: https://foundation-models.api.cloud.ru/v1
LLM_BASE_URL=
# Модель; можно несколько через запятую — запасные на случай ошибок. Рекомендуем:
# ai-sage/GigaChat3.5-432B-A28B,Qwen/Qwen3.5-397B-A17B,deepseek-ai/DeepSeek-V4-Pro
LLM_MODEL=
# Таймаут запроса к LLM, сек (по умолчанию 30). При ошибке агент сам переключается на правила
LLM_TIMEOUT=
# false — выключить LLM, не удаляя ключ (по умолчанию true)
LLM_ENABLED=

# --- Telegram-бот (необязательно): токен от @BotFather — тот же агент в мессенджере
TELEGRAM_BOT_TOKEN=

# --- Прочее
# Порт на хосте (по умолчанию 8080; внутри контейнера приложение всегда слушает 8080)
APP_PORT=
# Путь к SQLite (по умолчанию: в Docker /data/agent.db, без Docker ./data/agent.db)
DB_PATH=
# Зафиксировать «сегодня» для воспроизводимого демо, YYYY-MM-DD (по умолчанию реальная дата)
APP_TODAY=
# Уровень логов: DEBUG / INFO / WARNING (по умолчанию INFO)
LOG_LEVEL=
